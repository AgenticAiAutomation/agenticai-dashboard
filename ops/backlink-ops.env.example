# Backlink Ops — deployment variables.
# Copy to ops/backlink-ops.env, keep it out of git (it holds an API key).
#
# TARGET: agenticai-dashboard (FastAPI). NOT the Flask app at /var/www/agenticai
# — that is the public marketing site and is out of scope entirely.

# --- where the dashboard lives -------------------------------------------
APP_DIR=/var/www/agenticai-dashboard
SERVICE=dashboard-api
BRANCH=main
HEALTH_URL=https://api.dashboard.agenticaiautomation.co/api/seo/backlink-ops/health
PAGE_URL=https://dashboard.agenticaiautomation.co/seo/backlink-ops/
# A route that existed BEFORE this feature. The deploy gate checks it too, so a
# regression anywhere in the dashboard also triggers rollback.
BASELINE_URL=https://api.dashboard.agenticaiautomation.co/api/seo/backlinks

# --- feature flags (what the app itself reads) ---------------------------
BACKLINK_OPS_ENABLED=1
BACKLINK_OPS_READ_ONLY=0
BACKLINK_OPS_DB=instance/backlink_ops.db
BACKLINK_OPS_BACKUP_DIR=backups/backlink_ops
BACKLINK_OPS_URL_PREFIX=/seo/backlink-ops
BACKLINK_OPS_API_PREFIX=/api/seo/backlink-ops

# --- roles, mapped from the dashboard's existing ones ---------------------
# Superuser is by EMAIL, so escalation needs server access, not a UI click.
BACKLINK_OPS_SUPERUSERS=jai.prajapati91@gmail.com
BACKLINK_OPS_ADMIN_ROLES=admin,seo_lead
BACKLINK_OPS_VIEWER_ROLES=viewer
# Optional, and the most reliable wiring: point this at the dashboard's own
# dependency. "module:callable", receives the request, returns the user.
#   BACKLINK_OPS_USER_HOOK=app.deps:get_current_user_optional
BACKLINK_OPS_USER_HOOK=
# Only used if there is no hook and no request.state.user. Leave blank to
# disable — an unverified token is never trusted.
BACKLINK_OPS_JWT_SECRET=
BACKLINK_OPS_JWT_ALGS=HS256
BACKLINK_OPS_JWT_COOKIES=access_token,token,jwt

# --- AI layer. "none" runs on deterministic rules only. -------------------
# Providers: grok | gemini | anthropic | none
# Grok is the in-house default: free tier, ~20 calls a day.
# Model ids change — check https://docs.x.ai/docs/models, then confirm with
#   POST /api/seo/backlink-ops/ai-selftest
BACKLINK_OPS_AI_PROVIDER=none
BACKLINK_OPS_AI_MODEL=grok-3-mini
BACKLINK_OPS_AI_KEY=
BACKLINK_OPS_AI_BASE_URL=
BACKLINK_OPS_AI_DAILY_CAP=200
