# --- Core dashboard -------------------------------------------------------
DATABASE_URL=postgresql://dashboard_user:your_password_here@localhost/agenticai_dashboard
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
# 8 hours, matching the spec's idle-session rule.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=480
INITIAL_OWNER_EMAIL=contact@agenticaiautomation.co
INITIAL_OWNER_PASSWORD=change_on_first_login
CORS_ORIGINS=https://dashboard.agenticaiautomation.co,http://localhost:3000

# --- SEO Operations: go-live gate -----------------------------------------
# Until this file exists AND contains "GO LIVE YYYY-MM-DD" dated within the
# last 24 hours, every WordPress publish is forced to status=draft.
SEO_LIVE_APPROVAL_FILE=/var/www/agenticai-dashboard/SEO_LIVE_APPROVED.txt

# --- WordPress ------------------------------------------------------------
WP_BASE_URL=https://agenticaiautomation.co/blog
# Application password, NOT the wp-admin login password.
# infra/install-wordpress.sh generates both and records them in
# /root/wordpress-install-secrets.txt.
WP_APP_USER=
WP_APP_PASSWORD=

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Hard cap across draft generation, alt captions, and audit interpretation.
# Checked before every call; exceeding it returns 503, never a surprise bill.
SEO_DAILY_BUDGET_INR=500

# --- MinIO (featured images) ----------------------------------------------
# Leave blank to fall back to /var/www/agenticai-dashboard/uploads/seo-images.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=seo-images
MINIO_SECURE=true

# --- Scoring integrations -------------------------------------------------
# Self-hosted LanguageTool: docker run -d -p 8010:8010 erikvl87/languagetool
LANGUAGETOOL_URL=http://127.0.0.1:8010
# bge-m3 semantic coverage — reuse the running concierge-embedder service.
EMBEDDER_URL=

# --- Google ---------------------------------------------------------------
# Service-account JSON key paths. Keep the files in secrets/ (gitignored).
GSC_SERVICE_ACCOUNT_JSON=/var/www/agenticai-dashboard/secrets/gsc-service-account.json
GSC_SITE_URL=https://agenticaiautomation.co/
GA4_SERVICE_ACCOUNT_JSON=/var/www/agenticai-dashboard/secrets/ga4-service-account.json
GA4_PROPERTY_ID=

# --- SerpAPI (People Also Ask scraping) -----------------------------------
SERPAPI_KEY=

# --- Cron -----------------------------------------------------------------
# Shared secret sent as X-Cron-Secret. Generate with: openssl rand -hex 32
# While this is blank, every /api/seo/cron/* endpoint returns 503.
CRON_SECRET=
